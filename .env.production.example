# ==============================================================================
# Engaging Minds - Production Environment Configuration for AWS Lightsail
# Copy this file to .env on your Lightsail instance:
#   cp .env.production.example .env
# Then edit .env with your specific AWS account ID, region, domain, and credentials.
# ==============================================================================

# --- Domain & SSL Configuration ---
# Your domain name (e.g. mywebsite.com) and email for Let's Encrypt notifications
DOMAIN_NAME=mywebsite.com
LETSENCRYPT_EMAIL=admin@mywebsite.com

# --- AWS ECR Configuration ---
# Your AWS ECR Registry URI: <AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com
# Example: 123456789012.dkr.ecr.eu-west-1.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com
AWS_REGION=eu-west-1

# ECR Repository Names (matching GitHub Actions workflow)
ECR_BACKEND_REPO=engaging-minds-backend
ECR_FRONTEND_REPO=engaging-minds-frontend

# Image Tag to pull (defaults to 'latest')
IMAGE_TAG=latest

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongProductionPassword123!
POSTGRES_DB=engaging_minds

# --- Application Security & API Keys ---
# Secure random 32+ character JWT secret
JWT_SECRET=engaging-minds-production-jwt-super-secret-key-replace-me
JWT_EXPIRES_IN=1d

# Google Gemini API Key for Activity DSL generation & AI Block improvements
GEMINI_API_KEY=your_gemini_api_key_here
