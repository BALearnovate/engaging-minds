generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherActivities Activity[]   @relation("TeacherActivities")
  studentSubmissions Submission[] @relation("StudentSubmissions")

  @@map("users")
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("STRUCTURED_DSL")
  content     Json
  teacherId   String
  teacher     User     @relation("TeacherActivities", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  versions    ActivityVersion[]

  @@map("activities")
}

model ActivityVersion {
  id          String   @id @default(uuid())
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  definition  Json
  status      String   @default("DRAFT") // 'DRAFT' | 'PUBLISHED'
  shareCode   String?  @unique
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  sessions    ActivitySession[]

  @@map("activity_versions")
}

model ActivitySession {
  id                String          @id @default(uuid())
  activityVersionId String
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  teacherId         String
  shareCode         String          @unique
  status            String          @default("ACTIVE") // 'ACTIVE' | 'COMPLETED'
  createdAt         DateTime        @default(now())

  studentSessions   StudentSession[]

  @@map("activity_sessions")
}

model StudentSession {
  id                String          @id @default(uuid())
  activitySessionId String
  activitySession   ActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)
  studentId         String?
  studentName       String
  status            String          @default("NOT_STARTED") // 'NOT_STARTED' | 'IN_PROGRESS' | 'STUCK' | 'COMPLETED'
  progress          Float           @default(0)
  score             Float           @default(0)
  currentBlockId    String?
  lastSeenAt        DateTime        @default(now())

  events            ActivityEvent[]

  @@map("student_sessions")
}

model ActivityEvent {
  id               String         @id @default(uuid())
  studentSessionId String
  studentSession   StudentSession @relation(fields: [studentSessionId], references: [id], onDelete: Cascade)
  type             String
  blockId          String?
  payload          Json
  createdAt        DateTime       @default(now())

  @@map("activity_events")
}

model Submission {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  answers      Json
  score        Float
  totalBlanks  Int
  correctCount Int
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("submissions")
}
